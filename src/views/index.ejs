<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subscription Billing Control Center</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="page-shell">
        <main class="dashboard container">
            <header class="hero glass">
                <div class="hero-copy">
                    <p class="eyebrow">Sales Operations</p>
                    <h1>Subscription Billing Control Center</h1>
                    <p class="hero-subtitle">Manage customer onboarding, plan design, and subscription lifecycle from one professional workspace.</p>
                </div>
                <div class="hero-metrics">
                    <article class="kpi-card">
                        <p class="kpi-label">Total Customers</p>
                        <p class="kpi-value" id="kpiCustomers">0</p>
                    </article>
                    <article class="kpi-card">
                        <p class="kpi-label">Live Plans</p>
                        <p class="kpi-value" id="kpiPlans">0</p>
                    </article>
                    <article class="kpi-card">
                        <p class="kpi-label">Active Subs</p>
                        <p class="kpi-value" id="kpiActiveSubscriptions">0</p>
                    </article>
                </div>
            </header>

            <div id="alertsHost"></div>

            <section class="tabs-shell">
                <div class="view-controls">
                    <button id="densityToggle" class="control-btn" type="button" aria-label="Toggle density">Compact View</button>
                    <button id="refreshAll" class="control-btn secondary" type="button" aria-label="Refresh all data">Refresh Data</button>
                </div>
                <div class="tabs" role="tablist" aria-label="Billing modules">
                    <button class="tab-btn active" data-tab="customers" role="tab" aria-selected="true">Customers</button>
                    <button class="tab-btn" data-tab="plans" role="tab" aria-selected="false">Plans</button>
                    <button class="tab-btn" data-tab="subscriptions" role="tab" aria-selected="false">Subscriptions</button>
                </div>
            </section>

            <!-- CUSTOMERS TAB -->
            <section id="customers" class="tab-content active">
                <div class="section-grid">
                    <article class="form-section card glass">
                        <div class="section-header">
                            <h2>Create Customer</h2>
                            <p>Onboard a new account with billing defaults and location data.</p>
                        </div>
                        <form id="customerForm" class="form-grid">
                            <div class="full-span form-intro">
                                <p class="group-title">Identity and Account Type</p>
                                <p class="group-copy">Choose customer type first, then fill the required identity fields.</p>
                            </div>
                            <select id="customerType" required>
                                <option value="">Select Type</option>
                                <option value="individual">Individual</option>
                                <option value="company">Company</option>
                            </select>
                            <input type="text" placeholder="Frontend Customer ID (optional)" id="frCusid">
                            <input type="email" placeholder="Admin Email *" id="adminEmail" required>
                            <input type="tel" placeholder="Phone" id="phone">
                            <input type="text" placeholder="First Name" id="firstName">
                            <input type="text" placeholder="Last Name" id="lastName">
                            <input type="text" placeholder="Company Name" id="companyName">
                            <input type="text" placeholder="Company Tax ID" id="companyTaxId">
                            <div class="full-span form-intro">
                                <p class="group-title">Billing and Address</p>
                                <p class="group-copy">Address fields are mandatory for account provisioning and compliance checks.</p>
                            </div>
                            <input type="text" placeholder="Address (min 10 chars) *" id="addressSt" required>
                            <input type="text" placeholder="City *" id="city" required>
                            <input type="text" placeholder="State *" id="state" required>
                            <input type="number" step="0.01" placeholder="Credit Limit (default 0)" id="creditLimit">
                            <select id="country" required>
                                <option value="">Select Country</option>
                                <option value="IND">India (IND)</option>
                                <option value="USA">USA</option>
                                <option value="CAD">Canada (CAD)</option>
                                <option value="PAK">Pakistan (PAK)</option>
                                <option value="PHI">Philippines (PHI)</option>
                                <option value="BNG">Bangladesh (BNG)</option>
                                <option value="OTHER">Other</option>
                            </select>
                            <div id="customerFormErrors" class="form-errors full-span" aria-live="polite"></div>
                            <button type="submit">Create Customer</button>
                        </form>
                    </article>

                    <article class="data-section card">
                        <div class="section-header">
                            <h2>Customer Directory</h2>
                            <p>Review account identity, billing profile, and quick actions.</p>
                        </div>
                        <div class="table-wrap">
                            <table id="customersTable">
                                <thead>
                                    <tr>
                                        <th>Customer ID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Type</th>
                                        <th>Currency</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="customersBody"></tbody>
                            </table>
                        </div>
                    </article>
                </div>
            </section>

            <!-- PLANS TAB -->
            <section id="plans" class="tab-content">
                <div class="section-grid">
                    <article class="form-section card glass">
                        <div class="section-header">
                            <h2>Create Plan</h2>
                            <p>Define pricing, validity, and bundled allocation for new offers.</p>
                        </div>
                        <form id="planForm" class="form-grid">
                            <div class="full-span form-intro">
                                <p class="group-title">Commercial Terms</p>
                                <p class="group-copy">Set identifier, price, currency, and billing validity for this plan.</p>
                            </div>
                            <input type="text" placeholder="Plan ID" id="planId" required>
                            <input type="text" placeholder="Plan Name" id="planName" required>
                            <input type="number" placeholder="Amount" id="planAmount" step="0.01" required>
                            <select id="planCurrency" required>
                                <option value="usd">usd</option>
                                <option value="cad">cad</option>
                            </select>
                            <input type="number" placeholder="Validity (months)" id="validityMonths" required>
                            <div class="full-span form-intro">
                                <p class="group-title">Entitlements</p>
                                <p class="group-copy">DIDs and toll-free numbers share one number allowance. PBX Admins assign monitoring seats to users.</p>
                            </div>
                            <label for="numbers">Included numbers (DID + TFN)
                                <input type="number" id="numbers" min="0" step="1" value="0" required>
                            </label>
                            <label for="extensions">SIP extensions
                                <input type="number" id="extensions" min="0" step="1" value="0" required>
                            </label>
                            <label for="monitoringExtensions">Monitoring extensions
                                <input type="number" id="monitoringExtensions" min="0" step="1" value="0" required>
                            </label>
                            <div id="planFormErrors" class="form-errors full-span" aria-live="polite"></div>
                            <button type="submit">Create Plan</button>
                        </form>
                    </article>

                    <article class="data-section card">
                        <div class="section-header">
                            <h2>Plan Catalog</h2>
                            <p>Keep pricing tiers consistent with current sales and retention strategy.</p>
                        </div>
                        <div class="table-wrap">
                            <table id="plansTable">
                                <thead>
                                    <tr>
                                        <th>Plan ID</th>
                                        <th>Name</th>
                                        <th>Amount</th>
                                        <th>Validity</th>
                                        <th>Numbers</th>
                                        <th>Extensions</th>
                                        <th>Monitoring</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="plansBody"></tbody>
                            </table>
                        </div>
                    </article>
                </div>
            </section>

            <!-- SUBSCRIPTIONS TAB -->
            <section id="subscriptions" class="tab-content">
                <div class="section-grid">
                    <article class="form-section card glass">
                        <div class="section-header">
                            <h2>Create Subscription</h2>
                            <p>Link customers to plans and control lifecycle state at onboarding.</p>
                        </div>
                        <form id="subscriptionForm" class="form-grid compact-grid">
                            <div class="full-span form-intro">
                                <p class="group-title">Assignment</p>
                                <p class="group-copy">Pick a customer and an active plan to provision the subscription.</p>
                            </div>
                            <select id="subCustomerId" required>
                                <option value="">Select Customer</option>
                            </select>
                            <select id="subPlanId" required>
                                <option value="">Select Plan</option>
                            </select>
                            <select id="subStatus">
                                <option>active</option>
                                <option>suspended</option>
                                <option>cancelled</option>
                            </select>
                            <div id="subscriptionFormErrors" class="form-errors full-span" aria-live="polite"></div>
                            <button type="submit">Create Subscription</button>
                        </form>
                    </article>

                    <article class="data-section card">
                        <div class="section-header">
                            <h2>Subscription Ledger</h2>
                            <p>Track all lifecycle states, renewals, and account assignments.</p>
                        </div>
                        <div class="table-wrap">
                            <table id="subscriptionsTable">
                                <thead>
                                    <tr>
                                        <th>Subscription ID</th>
                                        <th>Customer ID</th>
                                        <th>Plan ID</th>
                                        <th>Status</th>
                                        <th>Start Date</th>
                                        <th>Next Billing</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="subscriptionsBody"></tbody>
                            </table>
                        </div>
                    </article>
                </div>
            </section>
        </main>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
