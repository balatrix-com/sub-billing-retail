# Primary Database Connection
DB_HOST=10.30.0.60
DB_PORT=5432
DB_NAME=bala_billing
DB_USER=bill_eng1
DB_PASSWORD=your-db-password

# Low-priority Read Replica / Pool Connection (e.g. PgBouncer)
READONLY_DB_HOST=10.30.0.60
READONLY_DB_PORT=5432
READONLY_DB_USER=bill_eng1
READONLY_DB_PASSWORD=your-db-password

# Service Environment
NODE_ENV=development
PBX_SUB_BILLING_SERVICE_SECRET=
DB_POOL_MAX=6
PORT=5005
BASE_URL=http://localhost:5000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Optional Sales Dashboard Webhook
SALES_DASHBOARD_WEBHOOK_URL=http://localhost:5010/api/payments/webhook/stripe
SALES_WEBHOOK=http://localhost:3000/payments/redirect

# Billing Cache Refresh API
BILLING_CACHE_REFRESH_URL=http://localhost:8005/api/v1/cache/refresh
BILLING_REC_CACHE_REFRESH_URL=http://localhost:8005/api/v1/cache/refresh-record
# Match the billing service REFRESH_CACHE_TOKEN (unique random 32+ characters).
BILLING_CACHE_REFRESH_TOKEN=

# PBX Integration
PBX_API_URL=http://localhost:3000
PBX_SYNC_TOKEN=your-super-secret-sync-token-change-in-production

# Recording wallet gate shared with billing-retail and t_2002.py
LOOKUP_REDIS_HOST=10.30.0.60
LOOKUP_REDIS_PORT=6379
LOOKUP_REDIS_DB=2
LOOKUP_REDIS_PASSWORD=
RECORDING_OVERLIMIT_SET_KEY=blacklist:customers:recording_overlimit
# Required: securely set the SAME random secret in PBX and sub-billing deployed .env files.
# Blank is intentional; never commit the real value. Restart both services after setting it.
SUBSCRIPTION_SERVICE_TOKEN=

# Subscription Lifecycle Worker Configuration
# If SUBSCRIPTION_WORKER_DRY_RUN is omitted or not 'false', automatic renewals and freezes are dry-run only.
# Set to 'false' to enable automatic renewals and automatic freeze on expiry.
SUBSCRIPTION_WORKER_DRY_RUN=false
SUBSCRIPTION_AUTO_RELEASE=false
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_RETENTION_DAYS=30

