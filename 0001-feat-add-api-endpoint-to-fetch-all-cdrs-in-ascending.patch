diff --git a/src/services/CdrService.js b/src/services/CdrService.js
index 6c33c1b..34e54b0 100644
--- a/src/services/CdrService.js
+++ b/src/services/CdrService.js
@@ -120,6 +120,83 @@ class CdrService {
       throw new Error(`Failed to fetch CDRs: ${err.message}`);
     }
   }
+
+  /**
+   * Get all CDRs with optional filtering and pagination in ascending order
+   * @param {Object} filters { search, startDate, endDate, limit, offset }
+   * @returns {Promise<Object>} { data: Array, total: number }
+   */
+  static async getAllCdrs(filters = {}) {
+    const { search, startDate, endDate, limit = 50, offset = 0 } = filters;
+    let baseQuery = `
+      FROM cdr
+      WHERE 1=1
+    `;
+    
+    const params = [];
+    let paramCount = 0;
+
+    if (search) {
+      paramCount++;
+      baseQuery += ` AND (caller LIKE $${paramCount} OR callee LIKE $${paramCount})`;
+      params.push(`%${search}%`);
+    }
+
+    if (startDate) {
+      paramCount++;
+      baseQuery += ` AND start_time >= $${paramCount}`;
+      params.push(startDate);
+    }
+
+    if (endDate) {
+      paramCount++;
+      baseQuery += ` AND start_time <= $${paramCount}`;
+      params.push(endDate);
+    }
+
+    const countQuery = `SELECT COUNT(*) as count ${baseQuery}`;
+    
+    let dataQuery = `
+      SELECT 
+        call_uuid,
+        caller, 
+        callee, 
+        direction as call_type,
+        duration_sec,
+        dest_value,
+        billed_amount as bill_amount,
+        dest_type,
+        billsec,
+        call_status as status,
+        start_time as created_at
+      ${baseQuery}
+      ORDER BY created_at ASC
+    `;
+
+    if (limit && limit !== 'all') {
+      paramCount++;
+      dataQuery += ` LIMIT $${paramCount}`;
+      params.push(limit);
+
+      paramCount++;
+      dataQuery += ` OFFSET $${paramCount}`;
+      params.push(offset);
+    }
+    
+    try {
+      const [countResult, dataResult] = await Promise.all([
+        readonlyPool.query(countQuery, params.slice(0, (countQuery.match(/\$/g) || []).length)),
+        readonlyPool.query(dataQuery, params)
+      ]);
+
+      return {
+        data: dataResult.rows,
+        total: parseInt(countResult.rows[0].count)
+      };
+    } catch (err) {
+      throw new Error(`Failed to fetch all CDRs: ${err.message}`);
+    }
+  }
 }
 
 module.exports = CdrService;
diff --git a/src/services/PBXDashboardService.js b/src/services/PBXDashboardService.js
index f1ab037..3b80b7e 100644
--- a/src/services/PBXDashboardService.js
+++ b/src/services/PBXDashboardService.js
@@ -115,6 +115,14 @@ class PBXDashboardService {
   static async getCustomerCDRs(customerId, filters = {}) {
     return await CdrService.getCdrsByCustomerId(customerId, filters);
   }
+
+  /**
+   * Get all CDRs formatted for PBX Dashboard
+   * @param {Object} filters
+   */
+  static async getAllCDRs(filters = {}) {
+    return await CdrService.getAllCdrs(filters);
+  }
 }
 
 module.exports = PBXDashboardService;
